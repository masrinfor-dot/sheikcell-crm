# API do Sheikcell — usado pelo EasyPanel (Build: Dockerfile)
FROM node:24-alpine
RUN apk add --no-cache python3 make g++ git
RUN npm install -g pnpm@10
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile
RUN pnpm --filter @workspace/api-server run build
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
# Inicia a API. O schema é aplicado pelo próprio processo Node, ANTES de
# abrir a porta (runMigrations() em src/index.ts) — roda os arquivos
# migrations/*.sql (hand-escritos, idempotentes, revisados) na ordem, e
# derruba o processo sem servir tráfego se algum falhar.
#
# 14/09: aqui tinha um "pnpm --filter @workspace/db run push-force" antes do
# node, pra tentar aplicar o schema.ts direto via drizzle-kit. Foi tentado
# como correção de um deploy que subiu sem 3 colunas novas, mas mesmo com
# --force elas continuaram faltando — a causa real era outra: os commits que
# adicionaram essas colunas ao schema.ts nunca criaram o migrations/*.sql
# correspondente (mesma classe de bug do apagão de 11/09, já documentada em
# migrate.ts). Removido de vez: além de redundante (a fonte de verdade real
# é migrations/*.sql, revisado por humano), rodar push --force sem revisão
# NENHUMA a cada boot é perigoso de verdade — --force aceita automaticamente
# QUALQUER confirmação do drizzle-kit, inclusive as de perda de dado
# (DROP COLUMN, mudança de tipo incompatível, rename adivinhado errado),
# baseado só num palpite heurístico, sem ninguém olhando.
CMD ["sh", "-c", "node --enable-source-maps artifacts/api-server/dist/index.mjs"]
