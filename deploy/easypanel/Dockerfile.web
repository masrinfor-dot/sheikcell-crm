# Site (frontend) do Sheikcell — usado pelo EasyPanel (Build: Dockerfile)
# node:24-slim (Debian/glibc) — o binário nativo do Rollup para Alpine (musl)
# não está no lockfile, então o build quebra em imagens alpine.
FROM node:24-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile
ENV BASE_PATH=/
ENV PORT=3000
RUN pnpm --filter @workspace/sheikcell run build

FROM nginx:alpine
COPY deploy/easypanel/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/artifacts/sheikcell/dist/public /usr/share/nginx/html
EXPOSE 80
