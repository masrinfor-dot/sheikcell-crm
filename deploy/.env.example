# Copie este arquivo para  /var/www/sheikcell/.env  e preencha os valores reais.
# NUNCA faça commit do .env com valores reais.

# Conexão com o PostgreSQL (obrigatório)
DATABASE_URL=postgres://sheikcell:SUA_SENHA@localhost:5432/sheikcell

# Segredo das sessões (obrigatório em produção).
# Também é usado para assinar as chamadas internas ao WhatsApp Bridge,
# então precisa ser IGUAL para os dois serviços (a API e o bridge).
# Gere um valor forte, ex.:  openssl rand -hex 32
SESSION_SECRET=

# Chave da OpenAI para os recursos de IA do chat (opcional, mas recomendado)
OPENAI_API_KEY=

# Chave mestra (32 bytes base64) que criptografa a chave OpenAI própria que
# cada loja pode colar (ver tenant_ai_credentials) — sem isso, lojas não
# conseguem salvar a própria chave. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CREDENTIALS_KEY=

# URL interna do WhatsApp Bridge (opcional — padrão já é este valor)
WHATSAPP_BRIDGE_URL=http://localhost:3002

# Token de verificação do webhook do WhatsApp Cloud API (opcional)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Nível de log (opcional): info | debug | warn | error
LOG_LEVEL=info

# Envio de e-mail via Resend (opcional, mas sem isso o "Esqueci minha senha"
# fica em silêncio: o endpoint sempre responde "ok" mesmo sem enviar nada,
# de propósito, pra não revelar quais e-mails existem — então sem essas
# duas variáveis configuradas ninguém recebe o link de redefinição, sem
# nenhum erro visível). Crie uma API key em resend.com e verifique o
# domínio do remetente antes de preencher EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=

# URL pública do sistema (usada para montar o redirect_uri do OAuth acima e
# o link de redefinição de senha por e-mail). Opcional em dev — sem isso,
# o servidor infere pelo host da requisição.
APP_URL=

# ERP (Prumo) — WhatsApp de compras (19/10/2026). Toda mensagem de fornecedor
# recebida numa conexão marcada "Encaminhar listas de fornecedores ao ERP"
# (Administração › WhatsApp) é mandada ao ERP, que lê a lista de preço com IA.
# Normalmente NÃO precisa preencher: o CRM usa o endereço e a chave do ERP
# gravados em Administração › Integrações (por loja). Estas variáveis são o
# fallback quando a loja não tem essa integração gravada.
# ERP_API_URL: endereço da API do ERP com /api/v1, ex.: https://api.sheikcell.com.br/api/v1
# ERP_API_KEY: chave gerada no ERP em Auxiliares › Integrações, com o acesso
#              "Listas de preço dos fornecedores (WhatsApp de compras)".
ERP_API_URL=
ERP_API_KEY=

# Caminho ABSOLUTO onde ficam os arquivos enviados (mídias do WhatsApp e
# documentos). Em produção isso PRECISA apontar para dentro do volume
# persistente montado no serviço "api" — sem isso, o caminho é resolvido a
# partir do diretório de trabalho do processo (que muda entre dev e o
# container Docker) e os arquivos somem a cada redeploy.
# Ex. no EasyPanel: monte um volume em /app/storage e use os valores abaixo.
MEDIA_DIR=/app/storage/media
DOCS_DIR=/app/storage/documents
