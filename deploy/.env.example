# Copie este arquivo para  /var/www/sheikcell/.env  e preencha os valores reais.
# NUNCA faça commit do .env com valores reais.

# Conexão com o PostgreSQL (obrigatório)
DATABASE_URL=postgres://sheikcell:SUA_SENHA@localhost:5432/sheikcell

# Segredo das sessões (obrigatório em produção).
# Também é usado para assinar as chamadas internas ao WhatsApp Bridge,
# então precisa ser IGUAL para os dois serviços (a API e o bridge).
# Gere um valor forte, ex.:  openssl rand -hex 32
SESSION_SECRET=

# Chave da OpenAI para os recursos de IA do chat (opcional, mas recomendado)
OPENAI_API_KEY=

# URL interna do WhatsApp Bridge (opcional — padrão já é este valor)
WHATSAPP_BRIDGE_URL=http://localhost:3002

# Token de verificação do webhook do WhatsApp Cloud API (opcional)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Nível de log (opcional): info | debug | warn | error
LOG_LEVEL=info

# Criptografia das credenciais do módulo Financeiro Bancário (obrigatório para
# usar esse módulo). Precisa decodificar para exatamente 32 bytes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FINANCE_CREDENTIALS_KEY=

# Segredo do webhook do PagBank (módulo Financeiro Bancário) — usado para
# validar a assinatura HMAC das notificações recebidas em
# POST /api/finance-bank/webhook/pagbank. Confirme o mecanismo real de
# assinatura na documentação oficial do PagBank antes de usar em produção
# (ver comentário de risco em lib/financeBank/adapters/pagbank.ts).
PAGBANK_WEBHOOK_SECRET=

# Valor (em centavos) acima do qual confirmar uma conciliação manual exige
# reautenticar por senha (módulo Financeiro Bancário). Opcional — padrão
# 500000 (R$ 5.000,00) se não definido.
FINANCE_REAUTH_THRESHOLD_CENTS=500000

# OAuth ("Conectar conta" sem colar token) do módulo Financeiro Bancário —
# só PagBank e Mercado Pago suportam esse fluxo. Cadastre um app no painel de
# desenvolvedores de cada um, com redirect_uri = <seu domínio>/api/finance-bank/oauth/<provider>/callback.
PAGBANK_CLIENT_ID=
PAGBANK_CLIENT_SECRET=
# sandbox | production — use sandbox até confirmar as credenciais reais
# (ver comentário de risco em lib/oauthProviders.ts sobre a URL de produção).
PAGBANK_ENV=sandbox

MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_ENV=sandbox

# Chave usada para assinar o "state" do fluxo OAuth acima (anti-CSRF).
# Opcional — sem isso, cai no SESSION_SECRET.
FINANCE_OAUTH_STATE_SECRET=

# URL pública do sistema (usada para montar o redirect_uri do OAuth acima e
# o link de redefinição de senha por e-mail). Opcional em dev — sem isso,
# o servidor infere pelo host da requisição.
APP_URL=
