{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Build real é via esbuild (build.mjs); o tsc só typechecka. Permitir
    // import "./x.ts" deixa os testes rodarem direto com `node --test`.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // Testa um arquivo do front (artifacts/sheikcell/src/lib/equipePedidos.ts),
  // fora de src: o typecheck do front cobre o arquivo testado.
  "exclude": ["src/lib/equipePedidos.test.ts"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/integrations-openai-ai"
    },
    {
      "path": "../../lib/integrations-email"
    }
  ]
}
